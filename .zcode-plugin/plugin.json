{
  "name": "soundcraft",
  "version": "0.1.0-dev.20261019.1",
  "description": "Dialogue cleanup, loudness matching, voice-over mixing, audio edits and loop stitching. Processing follows segments and silence ranges while keeping sync.",
  "license": "Apache-2.0",
  "skills": "./skills/",
  "displayName": "SoundCraft · Audio Editing",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "soundcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "en": "SoundCraft · Audio Editing"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "SoundCraft · Audio Editing",
          "zh-CN": "SoundCraft · 音频处理"
        },
        "icon": "audio-lines",
        "server": "soundcraft-editor",
        "resourceUri": "ui://soundcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
