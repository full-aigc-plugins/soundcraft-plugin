{
  "name": "soundcraft",
  "version": "0.1.0-dev.20261019.1",
  "description": "口播清理、多人响度统一、配音混音、音频剪辑与循环拼接；按段落与静音区间处理，保持对时关系。",
  "license": "Apache-2.0",
  "skills": "./skills/",
  "displayName": "SoundCraft（音频处理）",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "soundcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "zh-CN": "SoundCraft（音频处理）"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "SoundCraft (Audio Editing)",
          "zh-CN": "SoundCraft（音频处理）"
        },
        "icon": "music",
        "server": "soundcraft-editor",
        "resourceUri": "ui://soundcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
